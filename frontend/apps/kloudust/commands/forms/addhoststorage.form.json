        }
    },
    "form": {
        "description": "{{{i18n.AddStorageDescription}}}",
        "required_label": "{{{i18n.Required}}}",
        "required_fields": [
            {
                "id": "hostname",
                "type": "text",
                "placeholder": "{{{i18n.Hostname}}}",
                "required": true,
                "pattern": "\\s*[A-Za-z0-9]+\\s*",
                "validation_error": "{{{i18n.FieldValidationErrorGeneric}}}"
            },
            {
                "id": "nastype",
                "multioption": true,
                "type": "select",
                "label": "{{{i18n.NASType}}}",
                "options": [
                    {
                        "value": "nfs",
                        "label": "NFS"
                    },
                    {
                        "value": "cifs",
                        "label": "CIFS / SMB"
                    }
                ]
            },
            {
                "id": "nasaddress",
                "type": "text",
                "placeholder": "{{{i18n.NASAddress}}}",
                "required": true,
                "pattern": "\\s*[A-Za-z0-9\\.\\-]+\\s*",
                "validation_error": "{{{i18n.FieldValidationErrorGeneric}}}"
            },
            {
                "id": "naspath",
                "type": "text",
                "placeholder": "{{{i18n.NASPath}}}",
                "required": true,
                "pattern": "\\s*[A-Za-z0-9\\._/\\-]+\\s*",
                "validation_error": "{{{i18n.FieldValidationErrorGeneric}}}"
            }
        ],
        "optional_label": "{{{i18n.Advanced}}}",
        "optional_fields": [
            {
                "id": "nasuser",
                "type": "text",
                "placeholder": "{{{i18n.NASUser}}}",
                "pattern": "\\s*[A-Za-z0-9\\._@\\-]+\\s*"
            },
            {
                "id": "naspass",
                "type": "password",
                "placeholder": "{{{i18n.NASPassword}}}"
            }
        ],
        "submitlabel": "{{{i18n.AddStorageSubmitLabel}}}"
    }
}
