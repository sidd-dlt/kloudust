{
    "id": "addhoststorage",
    "command": "addHostStorage",
    "type": "kloudust_cmdline",
    "kloudust_cmdline_params": [
        "hostname",
        "nastype",
        "nasaddress",
        "naspath",
        "nasuser",
        "naspass"
    ],
    "title": "{{{i18n.AddStorageTitle}}}",
    "i18n": {
        "en": {
            "AddStorageTitle": "Add shared storage",
            "AddStorageDescription": "Mount the cloud's shared storage (NAS) on a host. VM disks, metadata, snapshots, images and the recycle bin move onto it, running VMs are moved live without downtime. All hosts must use the same storage.",
            "Hostname": "Cloud name of the host",
            "NASType": "Storage type",
            "NASAddress": "Shared storage server IP or DNS",
            "NASPath": "NFS export path or CIFS share name",
            "NASUser": "CIFS user ID",
            "NASPassword": "CIFS password",
            "AddStorageSubmitLabel": "Add",
            "FieldValidationErrorGeneric": "Validation error",
            "Advanced": "Optional",
            "Required": "Required"
        },
        "hi": {
            "AddStorageTitle": "Add shared storage",
            "AddStorageDescription": "Mount the cloud's shared storage (NAS) on a host. VM disks, metadata, snapshots, images and the recycle bin move onto it, running VMs are moved live without downtime. All hosts must use the same storage.",
            "Hostname": "Cloud name of the host",
            "NASType": "Storage type",
            "NASAddress": "Shared storage server IP or DNS",
            "NASPath": "NFS export path or CIFS share name",
            "NASUser": "CIFS user ID",
            "NASPassword": "CIFS password",
            "AddStorageSubmitLabel": "Add",
            "FieldValidationErrorGeneric": "Validation error",
            "Advanced": "Optional",
            "Required": "Required"
        },
        "ja": {
            "AddStorageTitle": "Add shared storage",
            "AddStorageDescription": "Mount the cloud's shared storage (NAS) on a host. VM disks, metadata, snapshots, images and the recycle bin move onto it, running VMs are moved live without downtime. All hosts must use the same storage.",
            "Hostname": "Cloud name of the host",
            "NASType": "Storage type",
            "NASAddress": "Shared storage server IP or DNS",
            "NASPath": "NFS export path or CIFS share name",
