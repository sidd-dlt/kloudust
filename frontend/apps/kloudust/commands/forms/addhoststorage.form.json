        },
        "zh": {
            "AddStorageTitle": "Add shared storage",
            "AddStorageDescription": "Mount the cloud's shared storage (NAS) on a host. VM disks, metadata, snapshots, images and the recycle bin move onto it, running VMs are moved live without downtime. All hosts must use the same storage.",
            "Hostname": "Cloud name of the host",
            "NASType": "Storage type",
